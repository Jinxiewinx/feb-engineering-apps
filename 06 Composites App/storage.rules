rules_version = '2';

// File storage for avatars and project files.
//
// Storage rules can't read Firestore and can't split get/list (that's a
// Firestore feature), so we can't do the full roster check here. What we DO
// enforce: only a signed-in user can touch storage at all; a user can only
// write their OWN avatar (avatars/{their-uid}); record attachments must be
// images, common doc types or native CAD under a size cap; and no path outside
// the trees named below is writable. A tree that is not declared here is denied,
// which is a safe default to fail in and also an easy one to forget: see the
// Shop-tab block for a season's worth of silently refused uploads. Reads require sign-in — needed because the client calls
// getDownloadURL() to display images.
//
// RESIDUAL (documented, low severity): a signed-in account that a lead hasn't
// added to the roster can still read a storage object IF it already knows the
// exact path. Two things make that impractical: listing is denied (no rule
// matches a listable prefix, so the bucket can't be walked), and paths are hard
// to guess (avatars use the random Auth uid; project files are prefixed with a
// millisecond timestamp). Fully gating reads to roster members needs Firebase
// Auth CUSTOM CLAIMS set by a Cloud Function on roster changes (then check
// `request.auth.token.roster` here) — a worthwhile follow-on now that we're on
// Blaze, but not built yet.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    /* A signed-in HUMAN WITH AN ACCOUNT, which is what every write rule below
       has always meant. Guests are signed in anonymously and are not that.

       THE HOLE THIS CLOSES IS ON WRITE, NOT READ, and that is worth stating
       because the read side looks like the scary one and is not. fb.upload()
       returns getDownloadURL() and every caller stores that token URL on the
       record — and a download-token URL bypasses these rules entirely. So any
       attachment reachable through a record a guest can read is already
       fetchable whatever this file says; the record read is the real boundary,
       and tightening read here would change nothing observable.

       What genuinely opens the moment anonymous auth is switched on is write:
       "allow write: if signedIn()" would mean anyone on the internet pushing
       10 MB — 50 MB for CAD — into a Blaze bucket. */
    function accountOf() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function sizeOk() { return request.resource.size < 10 * 1024 * 1024; }

    /* ---- native CAD ----
       Added August 2026, on Simon's ask. Until then a .SLDPRT or .STEP was
       refused by content type, so "the mold CAD" could only ever be a Drive
       link or a PDF of the drawing.

       TWO CONDITIONS, and both are load-bearing.

       The EXTENSION is checked, not just the type, because the content type on
       these is worth nothing: a browser has no MIME mapping for .SLDPRT, so
       file.type comes back empty and fb.upload falls back to
       application/octet-stream. Allowing octet-stream on its own would mean
       allowing any binary at all under any name.

       The TYPE is still checked, and this is the actual security condition. The
       risk with a widened upload is never the bytes, it is the browser being
       told to RENDER them: an object served as text/html or image/svg+xml from
       the bucket is stored XSS against every teammate who opens it. Restricting
       to octet-stream and model/* means nothing here can be rendered as a
       document, which is the same reasoning the stackplans/ rule below already
       runs on.

       lower() rather than an (?i) inline flag, because MOLD.STEP has to work as
       well as mold.step and people name exports in caps more often than not.
       The emulator cannot assert an ALLOW case here (its simple-upload endpoint
       leaves request.resource.contentType unset, so every contentType-gated
       rule evaluates false there) — which means a regex flag that silently
       failed to apply would not show up in any test, and would surface as a
       teammate's upload being refused at RFS. lower() cannot fail that way.

       Bigger cap, because these are genuinely bigger: a mold assembly at 10 MiB
       is not unusual and the whole point is that it now fits. 50 MiB against a
       5 GB free tier is ~100 files before it is worth a thought. */
    function cadName(n) { return n.lower().matches('.*\\.(step|stp|sldprt|sldasm|iges|igs|x_t|x_b|3mf|f3d|dxf|dwg|stl)'); }
    function cadTypeOk() { return request.resource.contentType.matches('(application/octet-stream|model/.*)'); }
    function cadOk(n) { return cadName(n) && cadTypeOk() && request.resource.size < 50 * 1024 * 1024; }

    // avatars/{uid} — owner writes only; anyone signed in can read (getDownloadURL).
    match /avatars/{uid} {
      allow read: if signedIn();
      allow write: if accountOf() && request.auth.uid == uid
        && sizeOk() && request.resource.contentType.matches('image/.*');
    }

    // projects/{projId}/{file} — any signed-in user may add a file; the file's
    // record lands in a roster-gated Firestore doc, so non-roster users can't
    // surface it. Images + common doc types only.
    match /projects/{projId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && (
        (sizeOk() && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)'))
        || cadOk(file));
    }

    // parts/{partId}/{file} — photos and files attached to a part's comment
    // thread and its Files section. Added when the rich composer rolled out
    // beyond tickets: there was no parts/ rule at all, and the file ends with
    // "no rule = deny", so a photo in a part comment failed silently at upload.
    // Same shape and same allowlist as projects/, CAD included — the mold CAD
    // evidence on the "Mold CAD/CAM Done" stage is attached here.
    match /parts/{partId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && (
        (sizeOk() && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)'))
        || cadOk(file));
    }

    /* ---- the Shop tab's three record types ----
       molds/, items/ and lots/, same shape and same allowlist as parts/ above,
       CAD included. A mold's DATUM CUT PLANS live here: the drawing of the
       reference cuts taken off a mold after a part has come out of it, uploaded
       on the mold's detail page. So does anything pasted into the rich-text
       Notes field on any of the three.

       THESE WERE MISSING UNTIL SEPTEMBER 2026, AND THIS FILE ENDS WITH "no rule
       = deny". renderShopDetail has wired richField's upload to
       `${spec.coll}/${o.id}/${Date.now()}-${name}` since the composer reached
       the Shop tab, so every photo anyone pasted into a mold, item or lot note
       was refused at upload. The toast says "Upload failed" and the note keeps
       its 1x1 placeholder, which reads as a flaky connection rather than a
       rule, so nobody reported it.

       Exactly the bug the parts/ rule above was added to fix, invisible for
       exactly the same reason: test_storage_rules.mjs asserted deny cases only.
       It now covers all three trees. */
    match /molds/{moldId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && (
        (sizeOk() && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)'))
        || cadOk(file));
    }

    match /items/{itemId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && (
        (sizeOk() && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)'))
        || cadOk(file));
    }

    match /lots/{lotId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && (
        (sizeOk() && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)'))
        || cadOk(file));
    }

    // documents/{file} — the Documents-tab library; any signed-in member uploads
    // (its record lands in the roster-gated `documents` Firestore collection).
    match /documents/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && sizeOk()
        && request.resource.contentType.matches('(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.*|text/.*)');
    }

    // budget/{purchaseId}/{file} — a receipt photo attached to a purchase; the
    // record lands in the roster-gated `budget` Firestore collection. A
    // receipt is always a photo (unlike documents/projects, no PDF/doc types).
    match /budget/{purchaseId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && sizeOk()
        && request.resource.contentType.matches('image/.*');
    }

    // stackplans/{planId}/mesh.stl — the mold mesh behind the Stock tab's 3D
    // view, decimated to fit sizeOk() before upload (see meshStlForStorage in
    // stlio.js). Its record lands in the roster-gated `stackplans` collection.
    // Binary STL has no registered MIME type everyone agrees on: the app sends
    // model/stl, but a browser that doesn't know the extension falls back to
    // application/octet-stream, so both are accepted. Neither is renderable, so
    // neither carries the stored-XSS risk an image/* or text/html upload would.
    match /stackplans/{planId}/{file} {
      allow read: if signedIn();
      allow write: if accountOf() && sizeOk()
        && request.resource.contentType.matches('(model/stl|application/octet-stream)');
    }

    // Everything else: denied (no rule = deny).
  }
}
