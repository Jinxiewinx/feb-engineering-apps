rules_version = '2';

// Access model: the roster. Anyone can create a Firebase Auth account and,
// since v4.4.0 (Simon, 2026-09-03), joins /roster on their own as a MEMBER;
// only a lead can make a lead, change a role, or remove someone. Nothing here
// is readable or writable without a roster doc. These rules are the actual
// enforcement — the app's hidden buttons are just UX.
service cloud.firestore {
  match /databases/{db}/documents {

    function onRoster() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(db)/documents/roster/$(request.auth.token.email));
    }

    /* A GUEST: Firebase anonymous auth. No email, no roster entry, read only.
       Gated on the SIGN-IN PROVIDER rather than on "token.email == null",
       because the provider is the fact we actually mean — a future custom-token
       or federated login that happens to arrive without an email must not
       silently become a guest.

       guest() appears in exactly one verb, read, and nowhere else in this file.
       Every create/update/delete clause below is unchanged and still says
       onRoster(), which already fails for a guest on its email clause — so
       read-only is enforced twice over, by two independent predicates. */
    function guest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    // Anyone allowed to READ a record: a roster member, or a guest.
    function reader() { return onRoster() || guest(); }

    function isLead() {
      return onRoster()
        && get(/databases/$(db)/documents/roster/$(request.auth.token.email)).data.role == "lead";
    }

    // Every data collection follows the same rule: any roster member can read
    // and write records, only a lead can delete. workOrders (WO-SN5/6-###),
    // parts (P-SN6-###), projects (PROJ-SN6-###), budget (BUY-SN6-###), and
    // schedule (one doc per week). Doc id = record id / week key.
    /* Deleting your own mistake is not the same act as deleting someone
       else's work. Every multi-record write in the app offers an Undo, and
       undo means delete — so a lead-only delete quietly made Undo a lead-only
       button. Worse, it made it a LYING button: undoCuts() splices the local
       array before the server refuses, so a member saw the row vanish, got a
       toast, and then watched the next snapshot put it back with the boards
       already restored and the offcuts still there. createdBy is stamped at
       creation by newShopRec and by the receive flow, so this is checkable.
       Records that predate createdBy stay lead-only, which is correct. */
    function mine() {
      return onRoster()
        && resource.data.keys().hasAny(['createdBy'])
        && resource.data.createdBy == request.auth.token.email;
    }

    /* ---------- how a delete works here now (September 2026) ----------
       The app soft-deletes: `deleted`, `deletedAt`, `deletedBy`, `purgeAfter`,
       `trashBatch`, `deletedFiles` and `backrefs` go onto the record, it leaves
       every rail and its public nameplate is removed, and a lead empties the
       bin after thirty days. `delete` below is that emptying, and nothing else.

       SO A MEMBER CAN NOW MAKE A LEAD-GATED RECORD DISAPPEAR, through `update`,
       which they have always had. Simon's call, knowingly: it is reversible for
       thirty days and the bin names who did it, which is a smaller thing to
       hand out than an irreversible delete.

       THERE IS DELIBERATELY NO tombstoneOnly() CLAUSE narrowing that update.
       It would restrict nothing that is not already open — `update: onRoster()`
       has always let a member blank every field on a mold — so it would read
       like a boundary while being decoration. If member updates are ever to be
       narrowed, that is its own change and it is about updates, not deletes. */
    match /workOrders/{id} { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    match /parts/{id}      { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    match /projects/{id}   { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    match /schedule/{id}   { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    match /budget/{id}     { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    // stock (BRD-###) = tooling-board inventory: full sheets and offcuts alike.
    // stackplans (STK-###) = a mold's sliced layer geometry, saved so the CS-003
    // §7.2 reviewer can reopen and initial it without re-slicing the mesh.
    match /stock/{id}      { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead() || mine(); }
    match /stackplans/{id} { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    // Documents: any member can upload/edit; only a lead prunes the library.
    match /documents/{id}  { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }

    /* The physical world, added with printed labels (2026-08-03).
       molds (MOLD-SN6-###) = a real mold, which outlives the work orders that
       use it — it used to exist only as free text inside one WO, so two WOs
       using the same mold held two copies of the truth and mold.location was
       wrong on one of them the moment anybody moved it.
       items = test panels, jigs and storage bins (PNL/JIG/BIN).
       lots  = fabric rolls and offcuts, resin and hardener, consumables
               (FAB/RSN/CON), which is what makes "which roll went into this
               panel" answerable.
       Both multi-class collections carry a `cls` field; same access shape as
       every other record collection. */
    match /molds/{id}      { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    /* items and lots delete was open to ANY roster member — Simon's call
       (2026-08-28) for the inventory Select…/mass-delete: shop consumables are
       shared property, and "only whoever logged the jug can delete it" made
       cleanup after the EH&S import a lead-only chore. Molds stayed lead-only:
       a mold is months of machining, not a jug.

       LEAD-ONLY AGAIN SINCE SEPTEMBER 2026, and that is not a reversal of it.
       Deleting from the app is now a TOMBSTONE, which is an update, which every
       member still has — so cleanup is still not a lead chore and the button
       still works for everybody. What `delete` means now is EMPTYING THE BIN,
       the one irreversible step, which takes the Storage objects with it. That
       one is a lead's. */
    match /items/{id}      { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }
    match /lots/{id}       { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead(); }

    /* rnd = the R&D bench (2026-08-28). A third multi-class collection:
       RDS-SN6-### is a STUDY — a named collection of coupons, which may be a
       plain folder, a test with a swept variable, or a project holding batches,
       all one record shape — and CPN-SN6-### is a COUPON, one physical test
       piece. Same access shape as every other record collection.

       THIS IS NOT THE `rnd` BOOLEAN ON A PART, and the shared word is the only
       thing the two have in common. parts.rnd means "a real part with a full
       traveler that is not a season deliverable": an evidence gate, a cure
       hold, a blocker, a signature. Nothing in this collection has any of
       those, nothing here is ever read by inSeason(), and no document here
       points at a part. See app/DESIGN-NOTES.md.

       delete is isLead() || mine() — the shape stock keeps, and NOT the wider
       onRoster() that items and lots were opened to above. That widening was
       for shared shop consumables, where "only whoever logged the jug may
       delete it" made cleanup a lead-only chore. A coupon is the opposite: it
       is somebody's experiment, and its result is data. mine() is what keeps
       the bulk-create Undo honest — Undo means delete, and a lead-only delete
       makes it a LYING button, since the rows vanish locally, the server
       refuses, and the next snapshot puts them back. createdBy is stamped at
       creation by both create paths, so this is always checkable. */
    match /rnd/{id}        { allow read: if reader(); allow create, update: if onRoster(); allow delete: if isLead() || mine(); }

    // Notifications: any member can create one (for a teammate); you can only
    // read/update/delete notifications addressed to YOU (a lead can prune any).
    // The app subscribes with where('to','==', myEmail), which matches the read rule.
    match /notifications/{id} {
      // `from` must be the creator's own email — can't forge who a ping is from.
      allow create: if onRoster() && request.resource.data.from == request.auth.token.email;
      allow read, update, delete: if onRoster()
        && (resource.data.to == request.auth.token.email || isLead());
    }

    // Doc id = member email (lowercase). role: "lead" | "member".
    // Bootstrap: the FIRST lead entry must be created from the Firebase
    // console (or emulator UI) — with an empty roster, nobody passes isLead().
    // A member may edit ONLY their own doc, and only avatar/name (never role) —
    // so people set their own photo without being able to promote themselves.
    match /roster/{email} {
      /* A guest reads the roster, and that is a DISCLOSURE DECISION rather than
         a convenience: doc ids are email addresses. It was taken knowing that
         closing it would not have withheld them anyway — createdBy, updatedBy,
         every buy-off, override and comment carries an address inside the
         records a guest can already read, so the only thing a closed roster
         costs is names, photos and training grants. An app that shows initials
         where a name belongs, for no protection. */
      allow read: if reader();
      allow delete: if isLead();
      /* Self-join: a signed-in account may create ITS OWN roster doc, as a
         member, with exactly the four fields sign-up writes. It cannot name
         a role, and it cannot create anyone else's doc. A lead can still add
         anybody with any role, as before. */
      allow create: if isLead() || (
        request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == email
        && request.resource.data.role == "member"
        && request.resource.data.keys().hasOnly(['name', 'role', 'addedBy', 'addedAt'])
      );
      allow update: if isLead() || (
        onRoster()
        && request.auth.token.email == email
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatar', 'name'])
      );
    }

    // meta/<collection> = { next: int } — one shared id counter per collection.
    // Increment-only, so a buggy or stray write can't rewind it and cause
    // duplicate ids.
    match /meta/{id} {
      allow read: if onRoster();
      allow create: if onRoster() && request.resource.data.next is int;
      /* Advance by more than one, so a delivery reserves its whole block of
         ids in ONE transaction instead of one round trip per record — 200
         sequential transactions on shop wifi is how a stock-take dies half
         written. The property this rule actually protects is stated above and
         is preserved exactly: the counter still cannot go backwards, so an id
         once minted can never be minted again. "+ 1" was never the safety
         property, only one way of spelling it. The ceiling is new protection
         the old rule did not have, and hasOnly() stops anything else riding
         along on a counter write. Gaps are the price, and gaps are free —
         cmpId() sorts by the number, so a burnt block is invisible. */
      allow update: if onRoster()
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next
        && request.resource.data.next <= resource.data.next + 50
        && request.resource.data.keys().hasOnly(['next']);
    }

    // config/<key> = small settings docs, e.g. config/slack { webhookUrl }.
    // Any roster member reads (the client needs it to post at runtime), but
    // only a lead configures it — a webhook URL is a live credential, so
    // writing it is not the same trust level as an ordinary record edit.
    match /config/{key} {
      /* NOT reader(). Two keys here are live credentials: config/slack holds an
         incoming-webhook URL, and config/tracker holds the 32-character token
         that IS the entire security on /tracker/{token} below — a guest who
         could read it could read the public feed's document directly, and hand
         the token to anybody.

         So an ALLOWLIST and not a denylist: a config key added next season is
         private until somebody decides otherwise, which is the safe direction
         for a default to fail in. These are the ones the UI needs to render a
         page at all.

         'techniques' joined in September 2026, when the layup techniques became
         lead-editable. A guest can read workOrders (reader() above), and every
         run names its technique on the list, on the record and on the printed
         traveler. Without this a run on a LEAD-ADDED technique renders its raw
         slug — "glassWrap" where the shop says "Glass wrapped core". It holds
         step titles and training ids, which a guest can already read off any
         work order, so it is a display fix and not a widening. */
      allow read: if onRoster()
        || (guest() && key in ['season', 'release', 'resins', 'restock', 'trainings', 'techniques', 'budget']);
      allow create, update: if isLead();
    }

    /* pub/<ID> = the public nameplate for one physical object, and THE ONLY
       THING IN THIS DATABASE AN UNAUTHENTICATED PERSON CAN READ.

       It exists because someone holding a labelled mold needs to know what it
       is without an account: a Jacobs staffer working out whose mold is
       blocking the container, a mech tech at comp, a member whose phone isn't
       signed in. Scanning a QR must not end at a login wall.

       It is a MIRROR, written by the app from a whitelist, never the record
       itself. That is forced, not chosen: Firestore rules cannot filter fields,
       only whole documents, so opening any read on workOrders would also hand
       out layupStack, every steps[].buyoff.name and every comment. The
       projection is the security boundary and it lives in pubProjection() in
       app/labels.js.

       `get` and not `read`: someone holding an ID gets that one document, but
       `list` stays behind the roster so nobody can dump the collection and
       learn how many molds exist or what the season's part list is.

       hasOnly() is the belt-and-braces. If a future refactor of
       pubProjection() ever spreads the whole object by accident, the write is
       rejected by the server rather than silently publishing a layup stack.
       Keep this list in sync with pubProjection() — they are two halves of one
       contract, and tools/test_pub_rules.mjs checks both.

       delete is onRoster(), deliberately looser than every other collection
       here (elsewhere it is isLead()). A public nameplate outliving its record
       is worse than a member being able to remove one, and fb.del() has to be
       able to clean up on the same path any member can delete on. */
    match /pub/{id} {
      allow get: if true;
      allow list: if onRoster();
      allow create, update: if onRoster()
        && request.resource.data.id == id
        && request.resource.data.keys().hasOnly([
             'id', 'cls', 'name', 'status', 'location', 'wo', 'rev', 'note', 'updatedAt'
           ]);
      allow delete: if onRoster();
    }

    /* tracker/<token> = the Google Sheet mirror feed: ONE document holding the
       whole season's part list, so the Composites Master Tracker in Drive can
       mirror the app without anybody typing everything twice.

       It exists because there is nowhere else to put it. Hosting is static,
       there are no Cloud Functions and no service account, so the 15-minute
       timer has to live inside the spreadsheet as a bound Apps Script — which
       means the spreadsheet PULLS, over plain HTTPS, with no credential it
       could safely be given. An unauthenticated REST GET is evaluated as
       request.auth == null and comes through these rules, so `allow get: if
       true` is what makes that fetch work with no API key and no OAuth. The
       app must not grow a Google sign-in (see app/gdocs.js).

       THIS IS A WIDER HOLE THAN /pub AND THE DIFFERENCE IS DELIBERATE, so say
       it plainly rather than leaving it to be discovered. /pub is `get` and
       not `read` precisely so nobody can dump the collection and learn the
       season's part list. This IS the season's part list, and unlike a
       nameplate it also carries engineer names and comment text.

       What protects it is the document id: a 32-char CSPRNG token, minted once
       by a lead and kept in config/tracker, never in source (this repo is
       public). The URL is the whole capability — the same trust model already
       applied to the Slack webhook next door in config/<key>. That is also
       what buys the extra columns: a guessable path would have forced dropping
       comments and shortening names, and the sheet would no longer match.

       `list` is denied to EVERYONE, not merely to the unauthenticated. A
       roster member can already read config/tracker, so this is not a wall
       against members — it is a belt-and-braces guarantee that the token
       cannot be recovered by enumerating the collection from a stolen session
       or a future bug that widens config.

       hasOnly() is the server-side backstop: if the projection in tracker.js
       ever regresses and starts spreading whole records, the write is rejected
       rather than silently publishing a layup stack. rows is capped so a
       runaway import cannot publish an unbounded document. Keep this list in
       sync with trackerSnapshot() — they are two halves of one contract, and
       tools/test_pub_rules.mjs checks both. */
    match /tracker/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if onRoster()
        && request.resource.data.keys().hasOnly(['rows', 'count', 'updatedAt'])
        && request.resource.data.rows.size() <= 500;
      allow delete: if isLead();
    }
  }
}
